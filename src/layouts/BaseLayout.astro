---
import '../styles/global.css';
import { SITE_URL, ogSiteNames } from '../data/site';
import { getGuide } from '../content/guide';
import { hreflangAlternates, localeMeta, pagePath, ui, type Locale } from '../i18n';
import { buildAttraction, buildWebSite } from '../lib/schema';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  locale?: Locale;
  path?: string;
  noIndex?: boolean;
  /** false 时只输出该语言自身的 canonical，不输出 hreflang（单语页面用） */
  i18n?: boolean;
  includeMainAttraction?: boolean;
}

const {
  title,
  description,
  image = '/images/og.jpg',
  locale = 'ja',
  path = '',
  noIndex = false,
  i18n = true,
  includeMainAttraction = true,
} = Astro.props;

const guide = getGuide(locale);
const pageTitle = title ?? guide.meta.title;
const pageDescription = description ?? guide.meta.description;

const site = Astro.site ?? new URL(SITE_URL);
const canonicalPath = pagePath(locale, path);
const canonicalHref = new URL(canonicalPath, site).toString();
const imageHref = new URL(image, site).toString();

const meta = localeMeta[locale];
const alternates = i18n ? hreflangAlternates(site.toString(), path) : [];
const t = ui[locale];

const attraction = buildAttraction(locale, canonicalHref, imageHref);
const website = buildWebSite(locale);
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <script is:inline>
      try {
        if (localStorage.getItem('jigoku-analytics-consent') === 'granted') {
          const s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP';
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          function gtag(){ dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', 'G-HXM22WWPKP');
        }
      } catch (_) { /* Storage may be disabled. */ }
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1b2922" />
    <meta name="color-scheme" content="light" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalHref} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={ogSiteNames[locale]} />
    <meta property="og:locale" content={meta.ogLocale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={imageHref} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={imageHref} />
    {
      alternates.map((alternate) => (
        <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />
      ))
    }
    {includeMainAttraction && <script type="application/ld+json" is:inline set:html={JSON.stringify(attraction)} />}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(website)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipLink}</a>
    <slot />
  </body>
</html>
