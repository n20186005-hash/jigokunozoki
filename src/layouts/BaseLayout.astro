---
import '../styles/global.css';
import { jigokuNozokiLocation } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const {
  title = '地獄のぞき｜鋸山・日本寺の絶景を訪ねる',
  description = '千葉県・鋸山の地獄のぞきへ。日本寺の拝観時間、料金、ロープウェー、アクセス、見どころ、モデルコースを日本語でわかりやすく案内します。',
  image = '/images/og.jpg',
  canonical = Astro.url.pathname,
} = Astro.props;

const canonicalUrl = new URL(canonical, Astro.site ?? Astro.url);
const imageUrl = new URL(image, Astro.site ?? Astro.url);
const canonicalHref = canonicalUrl.toString();
const imageHref = imageUrl.toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  name: '地獄のぞき',
  alternateName: ['Jigoku Nozoki', '地獄覗き'],
  description,
  url: canonicalHref,
  image: imageHref,
  hasMap: jigokuNozokiLocation.googleMapsUrl,
  address: {
    '@type': 'PostalAddress',
    postalCode: jigokuNozokiLocation.postalCode,
    addressRegion: jigokuNozokiLocation.addressRegion,
    addressLocality: jigokuNozokiLocation.addressLocality,
    streetAddress: jigokuNozokiLocation.streetAddress,
    addressCountry: 'JP',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: jigokuNozokiLocation.latitude,
    longitude: jigokuNozokiLocation.longitude,
  },
  isAccessibleForFree: false,
  touristType: ['自然景観', '寺院参拝', 'ハイキング', '写真撮影'],
};
---

<!doctype html>
<html lang="ja">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1b2922" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalHref} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="地獄のぞき｜鋸山旅案内" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={imageHref} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageHref} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <slot />
  </body>
</html>
