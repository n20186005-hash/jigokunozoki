---
import { ratingSnapshot } from '../data/site';
import type { GuideContent } from '../content/guide';
import { ui, type Locale } from '../i18n';

interface Props {
  hero: GuideContent['hero'];
  locale: Locale;
}

const { hero, locale } = Astro.props;
const t = ui[locale];
const ratingText = `${ratingSnapshot.value} / ${ratingSnapshot.count}${t.ratingCountUnit}`;
---

<section id="top" class="relative min-h-[800px] overflow-hidden bg-forest text-white lg:min-h-[900px]">
  <img
    src="/images/jigoku-nozoki-hero.webp"
    alt={hero.title}
    width="2200"
    height="1650"
    fetchpriority="high"
    class="absolute inset-0 h-full w-full object-cover object-[50%_42%]"
  />
  <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(17,28,22,.88)_0%,rgba(17,28,22,.45)_45%,rgba(17,28,22,.18)_72%),linear-gradient(0deg,rgba(17,28,22,.7)_0%,transparent_52%)]"></div>
  <div class="absolute inset-0 opacity-30 [background:linear-gradient(90deg,transparent_49.8%,rgba(255,255,255,.22)_50%,transparent_50.2%)] [background-size:90px_100%]"></div>

  <div class="container-shell relative flex min-h-[800px] items-end pb-16 pt-36 lg:min-h-[900px] lg:items-center lg:pb-0">
    <div class="grid w-full gap-12 lg:grid-cols-[1fr_auto] lg:items-center">
      <div class="max-w-3xl">
        <p class="mb-5 flex flex-wrap items-center gap-3 text-xs font-semibold tracking-[0.3em] text-white/70">
          <span class="h-px w-10 bg-vermilion"></span>
          {hero.eyebrow}
        </p>
        <h1 class="display-title text-[clamp(4rem,11vw,8.7rem)] leading-[.9] tracking-[-.08em]">{hero.title}</h1>
        <p class="mt-4 flex flex-wrap items-center gap-3 text-sm text-white/80">
          <span class="rounded-full border border-[#d7b675]/60 bg-black/25 px-3 py-1 font-semibold tracking-wide">
            ★ {ratingText}
          </span>
          <span class="text-xs text-white/55">{t.ratingLabel}</span>
        </p>
        <p class="mt-6 max-w-xl font-serif text-xl leading-relaxed text-white/88 md:text-2xl">{hero.lead}</p>
        <p class="mt-5 max-w-xl text-sm leading-7 text-white/68 md:text-base">{hero.text}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="#plan" class="inline-flex items-center gap-3 rounded-full bg-vermilion px-6 py-3.5 text-sm font-semibold tracking-wide text-white transition hover:-translate-y-0.5 hover:bg-[#934235]">
            {hero.primaryCta}
            <span aria-hidden="true">↘</span>
          </a>
          <a href="#info" class="inline-flex items-center gap-3 rounded-full border border-white/30 bg-white/5 px-6 py-3.5 text-sm font-semibold tracking-wide text-white backdrop-blur transition hover:bg-white hover:text-forest">
            {hero.secondaryCta}
          </a>
        </div>
      </div>

      <div class="hidden items-center gap-6 lg:flex">
        <p class="vertical-label text-xs text-white/55">{hero.eyebrow}</p>
        <div class="h-44 w-px bg-white/25"></div>
      </div>
    </div>
  </div>

  <div class="absolute inset-x-0 bottom-0 border-t border-white/15 bg-black/15 backdrop-blur-sm">
    <div class="container-shell grid grid-cols-2 divide-x divide-white/15 md:grid-cols-4">
      {
        hero.stats.map((stat) => (
          <div class="px-4 py-5 md:px-6">
            <span class="block text-[10px] tracking-[.18em] text-white/50">{stat.label}</span>
            <strong class="mt-1 block font-serif text-lg font-medium">{stat.value}</strong>
          </div>
        ))
      }
    </div>
  </div>
</section>
