---
import type { InfoCard as InfoCardType } from '../content/guide';

interface Props {
  card: InfoCardType;
}

const { card } = Astro.props;
---

<div class="bg-[#eee8dc] p-6 md:p-8">
  <p class="text-[10px] tracking-[.18em] text-vermilion">{card.label}</p>
  <h3 class="mt-3 font-serif text-2xl">{card.title}</h3>
  {card.main && <p class="mt-5 font-serif text-4xl">{card.main}</p>}
  {card.sub && <p class="mt-2 text-sm text-ink/55">{card.sub}</p>}
  {
    card.rows && (
      <div class="mt-5">
        {card.rows.map((row, rowIndex) => (
          <div class:list={['flex items-end justify-between', rowIndex === 0 ? 'border-b border-ink/10 pb-3' : 'mt-3']}>
            <span class="text-sm text-ink/55">{row.label}</span>
            <strong class="font-serif text-3xl font-medium">{row.value}</strong>
          </div>
        ))}
      </div>
    )
  }
  {card.text && <p class="mt-4 text-sm leading-7 text-ink/58">{card.text}</p>}
</div>
