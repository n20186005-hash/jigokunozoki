---
import { templeFacts } from '../data/site';
import type { GuideContent } from '../content/guide';
import { localeMeta, type Locale } from '../i18n';

interface Props {
  cost: GuideContent['cost'];
  locale: Locale;
}

const { cost, locale } = Astro.props;
const numberLocale = localeMeta[locale].numberLocale;
const formatter = new Intl.NumberFormat(numberLocale);
const initialTemple = templeFacts.admissionAdult;
const initialRopeway = templeFacts.ropewayAdultRound;
const initialTotal = initialTemple + initialRopeway;
---

<section id="cost" class="border-y border-ink/10 bg-[#ece5d8] py-16 md:py-20">
  <div class="container-shell grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-center lg:gap-20">
    <div class="reveal">
      <span class="eyebrow">{cost.eyebrow}</span>
      <h2 class="display-title text-4xl md:text-5xl">{cost.title}</h2>
      <p class="mt-5 max-w-md text-sm leading-8 text-ink/65 md:text-base">{cost.text}</p>
    </div>

    <div
      id="cost-calculator"
      class="reveal paper-card p-6 md:p-8"
      style="transition-delay: 100ms"
      data-number-locale={numberLocale}
      data-suffix={cost.suffix}
      data-temple-label={cost.templeLabel}
      data-ropeway-label={cost.ropewayTerm}
    >
      <div class="grid gap-5 sm:grid-cols-3">
        <label class="block">
          <span class="mb-2 block text-xs font-semibold tracking-wider text-ink/55">{cost.adultLabel}</span>
          <select id="adult-count" class="w-full rounded-none border border-ink/15 bg-white/65 px-4 py-3 text-base">
            <option value="0">0</option>
            <option value="1" selected>1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
            <option value="6">6</option>
          </select>
        </label>
        <label class="block">
          <span class="mb-2 block text-xs font-semibold tracking-wider text-ink/55">{cost.childLabel}</span>
          <select id="child-count" class="w-full rounded-none border border-ink/15 bg-white/65 px-4 py-3 text-base">
            <option value="0" selected>0</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
            <option value="6">6</option>
          </select>
        </label>
        <label class="block">
          <span class="mb-2 block text-xs font-semibold tracking-wider text-ink/55">{cost.ropewayLabel}</span>
          <select id="ropeway-type" class="w-full rounded-none border border-ink/15 bg-white/65 px-4 py-3 text-base">
            <option value="round" selected>{cost.options.round}</option>
            <option value="oneway">{cost.options.oneway}</option>
            <option value="none">{cost.options.none}</option>
          </select>
        </label>
      </div>

      <div class="mt-8 flex flex-col gap-5 border-t border-ink/12 pt-7 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-xs tracking-[.16em] text-ink/45">{cost.resultLabel}</p>
          <p id="cost-result" class="mt-1 font-serif text-4xl font-medium" aria-live="polite">
            {formatter.format(initialTotal)}{cost.suffix}
          </p>
        </div>
        <div class="max-w-sm text-xs leading-6 text-ink/50">
          <p>
            {cost.breakdownLabel}：<span id="cost-breakdown">{cost.templeLabel} {formatter.format(initialTemple)}{cost.suffix} + {cost.ropewayTerm} {formatter.format(initialRopeway)}{cost.suffix}</span>
          </p>
          <p>{cost.note}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  type RopewayType = 'round' | 'oneway' | 'none';

  const calculator = document.querySelector<HTMLElement>('#cost-calculator');
  const adultSelect = document.querySelector<HTMLSelectElement>('#adult-count');
  const childSelect = document.querySelector<HTMLSelectElement>('#child-count');
  const ropewaySelect = document.querySelector<HTMLSelectElement>('#ropeway-type');
  const result = document.querySelector<HTMLElement>('#cost-result');
  const breakdown = document.querySelector<HTMLElement>('#cost-breakdown');

  const suffix = calculator?.dataset.suffix ?? '円';
  const templeLabel = calculator?.dataset.templeLabel ?? '日本寺';
  const ropewayLabel = calculator?.dataset.ropewayLabel ?? 'ロープウェー';
  const formatter = new Intl.NumberFormat(calculator?.dataset.numberLocale ?? 'ja-JP');
  const ropewayAdult: Record<RopewayType, number> = { round: 1200, oneway: 650, none: 0 };
  const ropewayChild: Record<RopewayType, number> = { round: 600, oneway: 320, none: 0 };

  const calculate = (): void => {
    if (!adultSelect || !childSelect || !ropewaySelect || !result || !breakdown) return;

    const adults = Number(adultSelect.value);
    const children = Number(childSelect.value);
    const route = ropewaySelect.value as RopewayType;
    const temple = adults * 700 + children * 400;
    const ropeway = adults * ropewayAdult[route] + children * ropewayChild[route];
    const total = temple + ropeway;

    result.textContent = `${formatter.format(total)}${suffix}`;
    breakdown.textContent = `${templeLabel} ${formatter.format(temple)}${suffix} + ${ropewayLabel} ${formatter.format(ropeway)}${suffix}`;
  };

  [adultSelect, childSelect, ropewaySelect].forEach((select) => select?.addEventListener('change', calculate));
</script>
