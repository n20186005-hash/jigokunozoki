---
import { shortBrand } from '../data/site';
import { pagePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const labels = {
  ja: ['プライバシーポリシー', '利用規約', 'Cookie 設定'],
  en: ['Privacy Policy', 'Terms of Service', 'Cookie Settings'],
  zh: ['隱私政策', '服務條款', 'Cookie 設定'],
}[locale];
---

<footer class="bg-[#121b16] text-white">
  <div class="container-shell flex flex-col gap-5 py-10 text-xs sm:flex-row sm:items-center sm:justify-between">
    <p class="text-white/65">© {new Date().getFullYear()} {shortBrand[locale]} · {locale === 'ja' ? '無断転載を禁じます' : locale === 'en' ? 'All rights reserved' : '版權所有'}</p>
    <nav class="flex flex-wrap gap-x-6 gap-y-3 text-white/65" aria-label="Legal">
      <a class="transition hover:text-white" href={pagePath(locale, 'privacy-policy')}>{labels[0]}</a>
      <a class="transition hover:text-white" href={pagePath(locale, 'terms-of-service')}>{labels[1]}</a>
      <a class="transition hover:text-white" href={pagePath(locale, 'cookie-settings')}>{labels[2]}</a>
    </nav>
  </div>
</footer>
